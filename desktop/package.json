{
  "name": "pearoffice-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PearOffice desktop app (Electron). Starts the shared Bare worklet and hosts the web UI.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node smoke.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "PeerLoom LLC",
    "email": "support@peerloomllc.com"
  },
  "homepage": "https://github.com/peerloomllc/pearoffice",
  "build": {
    "appId": "com.peerloomllc.pearoffice",
    "productName": "PearOffice",
    "copyright": "Copyright 2026 PeerLoom LLC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "worklet.js",
      "seeder-process.js",
      "paths.js",
      "login.js",
      "appimage.js",
      "updates.js",
      "vendor/**",
      "smoke-run.js",
      "smoke/**",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/resources",
        "to": "."
      }
    ],
    "protocols": [
      {
        "name": "PearOffice invite",
        "schemes": [
          "pearoffice"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "PearOffice-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "PearOffice connects directly to the people you share files with, and to your own devices, on your network."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "desktop": {
        "entry": {
          "StartupWMClass": "pearoffice-desktop"
        }
      },
      "icon": "build/icon.png",
      "artifactName": "pearoffice-${version}-linux-${arch}.${ext}",
      "synopsis": "Peer-to-peer shared spreadsheets",
      "description": "Shared spreadsheets that sync device to device. No accounts, no servers."
    },
    "deb": {
      "packageName": "pearoffice"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "PearOffice-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
