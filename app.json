{
  "expo": {
    "name": "PearSheet",
    "slug": "pearsheet",
    "version": "0.1.0",
    "newArchEnabled": true,
    "orientation": "default",
    "scheme": "pearsheet",
    "userInterfaceStyle": "automatic",
    "icon": "./desktop/build/icon.png",
    "android": {
      "package": "com.pearsheet",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./desktop/build/icon.png",
        "backgroundColor": "#f7f7f4"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "pearsheet",
              "host": "join"
            },
            {
              "scheme": "pearsheet",
              "host": "seeder"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.pearsheet",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/with-android-debug-standalone",
      "./plugins/with-android-abis",
      "./plugins/with-gradle-jvmargs",
      "./plugins/with-ios-pod-deployment-target",
      "./plugins/with-ios-scene-lifecycle"
    ],
    "assets": [
      "./assets/bare-universal.bundle",
      "./assets/bare-ios.bundle",
      "./assets/app-ui.bundle"
    ]
  }
}
