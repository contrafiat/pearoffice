#!/bin/sh
# PearOffice seeder launcher, last release: the PearOffice seeder is now
# PeerLoom Seeder, one seeder for every PeerLoom app. This runs the PeerLoom
# Seeder copy in seeder/peerloom-seeder on the same data folder
# ($PEAROFFICE_SEEDER_DATA, or ~/.pearoffice-seeder). Same code, same data
# layout, so the seeder key, paired devices and stored files are kept.
#
#   pearoffice-seeder           run it; pair devices from the dashboard on
#                               http://127.0.0.1:8761
#   pearoffice-seeder update    install the newest PeerLoom Seeder over the
#                               copy in seeder/peerloom-seeder
#
# The older launcher's `update` moves bare, seeder/ and this file into place,
# which is how an existing install gets here. See
# proposals/2026-10-12-peerloom-seeder-product.md in the suite root.
umask 077
here="$(cd "$(dirname "$0")" && pwd)"
seeder="$here/seeder/peerloom-seeder/peerloom-seeder"
export SEEDER_DATA="${PEAROFFICE_SEEDER_DATA:-$HOME/.pearoffice-seeder}"
[ -n "$PEAROFFICE_NO_UPDATE_CHECK" ] && export SEEDER_NO_UPDATE_CHECK=1

say () { echo "[pearoffice-seeder] $*"; }

case "$1" in
  update)
    "$seeder" update || exit $?
    if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet pearoffice-seeder 2>/dev/null; then
      systemctl --user restart pearoffice-seeder && say "restarted the pearoffice-seeder service"
    fi
    exit 0 ;;
  ""|run) ;;
  *) echo "usage: pearoffice-seeder [run | update]"; exit 2 ;;
esac

mkdir -p "$SEEDER_DATA"
say "The PearOffice seeder is now PeerLoom Seeder. It keeps your seeder, paired devices and files, and serves every PeerLoom app."
say "Pair devices from the dashboard: http://127.0.0.1:${SEEDER_PORT:-8761}"
exec "$seeder" run
